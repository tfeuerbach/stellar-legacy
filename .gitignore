.vscode/
.idea/
*.swp
*.swo

# Docker volumes / runtime data
/data/

# Lock files are useful to track — keep them
# (package-lock.json ensures reproducible builds)

# Minecraft — ignore all upstream textures, then un-ignore only the ones we use
minecraft/src/static/textures/
!minecraft/src/static/textures/block/
minecraft/src/static/textures/block/*
!minecraft/src/static/textures/block/stone.png
!minecraft/src/static/textures/block/coal_ore.png
!minecraft/src/static/textures/block/iron_ore.png
!minecraft/src/static/textures/block/grass_block_side.png
!minecraft/src/static/textures/block/grass_top_green.png
!minecraft/src/static/textures/block/dirt.png
!minecraft/src/static/textures/block/oak_log.png
!minecraft/src/static/textures/block/oak_log_top.png
!minecraft/src/static/textures/block/oak_leaves.png
!minecraft/src/static/textures/block/sand.png
!minecraft/src/static/textures/block/oak_planks.png
!minecraft/src/static/textures/block/diamond_block.png
!minecraft/src/static/textures/block/quartz_block_side.png
!minecraft/src/static/textures/block/glass.png
!minecraft/src/static/textures/block/bedrock.png

