[Unit]
Description=Cloudflare Tunnel (stellar-legacy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5
# Install cloudflared to ~/.local/bin (see deploy/setup-cloudflared-tunnel.sh)
ExecStart=%h/.local/bin/cloudflared --no-autoupdate tunnel --config %h/.cloudflared/config.yml run
Environment=HOME=%h

[Install]
WantedBy=default.target
